# ==================== APPLICATION ====================
NODE_ENV=development
PORT=5000
APP_NAME=School Management System
API_PREFIX=/api/v1

# ==================== DATABASE ====================
MONGODB_URI=mongodb://localhost:27017/school_management
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/school_management

# ==================== JWT TOKENS ====================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_REFRESH_SECRET=your-different-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ==================== SECURITY ====================
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=30 # minutes
SESSION_EXPIRE=30 # days

# ==================== CORS ====================
CLIENT_URL=http://localhost:3000
CLIENT_URL_PROD=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW=15 # minutes
RATE_LIMIT_MAX=100
RATE_LIMIT_MAX_AUTH=5

# ==================== EMAIL CONFIGURATION ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ==================== REDIS (Optional) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== FILE UPLOAD ====================
MAX_FILE_SIZE=5242880 # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg
UPLOAD_PATH=uploads/

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

# ==================== API KEYS ====================
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ==================== BACKUP ====================
BACKUP_PATH=backups/
BACKUP_RETENTION_DAYS=7